GLEAN_ADDR=:8080
GLEAN_DB=glean.db
GLEAN_SESSION_KEY=change-me-to-a-random-string
GLEAN_JETSTREAM=wss://jetstream.glean.at
GLEAN_PLC_URL=https://didplc.glean.at
GLEAN_SYNC_INTERVAL=30m
GLEAN_CLUSTER_INTERVAL=60m
GLEAN_FETCH_INTERVAL=15m
GLEAN_COLLECTION_DIR_URL=https://lightrail.microcosm.blue/xrpc/com.atproto.sync.listReposByCollection?collection=at.glean.subscription
GLEAN_BACKFILL_CONCURRENCY=5
# Leave empty for localhost OAuth (development)
# GLEAN_OAUTH_CLIENT_ID=https://glean.at/oauth/client-metadata
# GLEAN_OAUTH_REDIRECT_URL=https://glean.at/auth/callback
# Embeddings (recommended — powers content-based feed/article recommendations)
# Point to any OpenAI-compatible /v1/embeddings endpoint (OpenAI, Ollama, etc.)
# Without embeddings, recommendations rely only on subscription overlap and social graph.
GLEAN_EMBED_BASE_URL=https://api.openai.com/v1
GLEAN_EMBED_API_KEY=sk-...
GLEAN_EMBED_MODEL=text-embedding-3-small
GLEAN_EMBED_DIMENSION=1536
